# Firebase Admin SDK (from Firebase Console → Project Settings → Service Accounts → Generate new private key)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# Private key with \n as literal backslash-n (Vercel env vars handle this automatically)
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQIBADANBg...\n-----END PRIVATE KEY-----\n"

# Admin dashboard access token (set a long random string, e.g. openssl rand -hex 32)
ADMIN_TOKEN=change-me-to-a-long-random-string
